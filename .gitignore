/target/
/node_modules/
/artifacts/
/test-results/
/mutants.out/
# Generated release payloads are content-addressed and reconstructed by
# the installed Spice `dev xtask -- stage-target`; they are not task-source work.
/dist/stage/objects/
/dist/stage/targets/

# The sole browser app generation store. Each lane publishes it with
# installed Spice `dev xtask -- app`; no resident falls back when its current generation is absent.
# Publications into it serialize on the lock file beside it.
/dist/stage-app/
/dist/.stage-app.lock

# Snapshots, console logs and screenshots the Playwright MCP browser writes
# beside the worktree. Every lane is told to validate the canvas through that
# browser, so without this each one leaves untracked evidence behind -- and a
# gate that walks the filesystem rather than the tracked set counts it as an
# input to the build.
/.playwright-mcp/
/dist/.stage-app-build-*/
/.spice/
